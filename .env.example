# Optional — enables Claude structured synthesis.
# Without this key, the API falls back to deterministic rules-based synthesis.
ANTHROPIC_API_KEY=

# Optional override (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Open-Meteo, NWS (api.weather.gov), and AviationWeather.gov need no keys.
